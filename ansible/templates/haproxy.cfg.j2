{# haproxy.cfg.j2 — TCP load balancer for the kube-apiserver.
   Rendered per-node by k8s-cluster.yaml Play 3. mode tcp = L4 passthrough
   (TLS is terminated by the API server, not here). Listens on :6443 and
   round-robins to every control node's kubelet-apiserver port :6444 with a
   health check, so the keepalived VIP always lands on a live API endpoint. #}
global
  log /dev/log local0
  chroot /var/lib/haproxy
  stats socket /run/haproxy/admin.sock mode 660 level admin
  stats timeout 30s
  user haproxy
  group haproxy
  daemon

defaults
  log global
  mode tcp
  timeout connect 5s
  timeout client 30s
  timeout server 30s

frontend k8s_api
  bind *:6443
  default_backend k8s_api_backends

backend k8s_api_backends
  balance roundrobin
{% for peer in groups['k8s_control'] | sort %}
  server {{ peer }} {{ hostvars[peer]['node_ip'] }}:6444 check
{% endfor %}
