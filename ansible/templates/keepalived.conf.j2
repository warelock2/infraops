{# keepalived.conf.j2 — VRRP config for the control-plane virtual IP.
   Rendered per-node by k8s-cluster.yaml Play 3.
   priority is derived from the node's alphabetical position in the group,
   so the leader (index 0) gets the highest priority and owns the VIP.
   unicast_peer lists every OTHER control node, so VRRP health traffic flows
   without multicast. nopreempt keeps the VIP stable across failovers. #}
global_defs {
  router_id {{ inventory_hostname }}
}

vrrp_instance VI_1 {
  state BACKUP
  interface {{ node_iface }}
  virtual_router_id 51
  priority {{ 100 + (groups['k8s_control'] | sort).index(inventory_hostname) }}
  nopreempt
  unicast_src_ip {{ node_ip }}
  unicast_peer {
{% for peer in (groups['k8s_control'] | sort) if peer != inventory_hostname %}
    {{ hostvars[peer]['node_ip'] }}
{% endfor %}
  }
  virtual_ipaddress {
    {{ cp_vip }}
  }
}
