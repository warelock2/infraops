global_defs {
  router_id {{ inventory_hostname }}
}

vrrp_instance VI_1 {
  state BACKUP
  interface {{ node_iface }}
  virtual_router_id 51
  priority {{ 100 + (groups['k8s_control'] | sort).index(inventory_hostname) }}
  nopreempt
  unicast_src_ip {{ node_ip }}
  unicast_peer {
{% for peer in (groups['k8s_control'] | sort) if peer != inventory_hostname %}
    {{ hostvars[peer]['node_ip'] }}
{% endfor %}
  }
  virtual_ipaddress {
    {{ cp_vip }}
  }
}
