{# docker-compose.yml.j2 — Keycloak container definition.
   Rendered by keycloak-deploy.yaml Play 2. HTTPS-only: the container binds
   TLS on the internal port (kc_container_port) mapped to the host port
   (kc_host_port). The bootstrap admin password comes from the .env file
   (${KC_BOOTSTRAP_ADMIN_PASSWORD}) rather than being baked into compose,
   so the secret never lands in the repo or the rendered manifest. #}
services:
  {{ kc_container_name }}:
    image: "{{ kc_container_image }}"
    container_name: {{ kc_container_name }}
    command: start
    environment:
      KC_HOSTNAME: "{{ kc_domain }}"
      KC_HTTPS_CERTIFICATE_FILE: /etc/keycloak/certs/tls.crt
      KC_HTTPS_CERTIFICATE_KEY_FILE: /etc/keycloak/certs/tls.key
      KC_HTTP_ENABLED: "false"
      KC_HTTPS_PORT: "{{ kc_container_port }}"
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KC_BOOTSTRAP_ADMIN_PASSWORD}
    volumes:
      - ./keycloak.conf:/opt/keycloak/conf/keycloak.conf:ro
      - ./certs:/etc/keycloak/certs:ro
    ports:
      - "{{ kc_host_port }}:{{ kc_container_port }}"
    restart: unless-stopped
