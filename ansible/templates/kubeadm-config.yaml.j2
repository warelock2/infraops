{# kubeadm-config.yaml.j2 — kubeadm init/join configuration.
   Rendered per-node by k8s-cluster.yaml Play 5. Three documents:
   InitConfiguration  -> API server binds :6444 locally (haproxy fronts :6443)
   ClusterConfiguration -> cluster-wide: version, image registry, control
      plane endpoint (the VIP/haproxy DNS name), pod CIDR, and OIDC flags so
      the API server validates Keycloak tokens with the groups claim. The
      issuer ({{ oidc_issuer_url }}) is served by the Let's Encrypt *.afobl.com
      wildcard, so no oidc-ca-file pin is set — the API server validates it
      against the system CA store.
   KubeletConfiguration -> systemd cgroup driver (matches containerd).
   All values come from group_vars/extra-vars, never hardcoded. #}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}
  bindPort: 6444
nodeRegistration:
  criSocket: unix:///var/run/containerd/containerd.sock
  name: {{ inventory_hostname }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ k8s_version }}
imageRepository: {{ k8s_image_repository }}
controlPlaneEndpoint: "{{ cp_endpoint }}"
networking:
  podSubnet: {{ pod_network_cidr }}
apiServer:
  certSANs:
    - "{{ cp_api_host }}"
    - "{{ cp_vip }}"
  extraArgs:
    - name: oidc-issuer-url
      value: {{ oidc_issuer_url }}
    - name: oidc-client-id
      value: {{ oidc_client_id }}
    - name: oidc-username-claim
      value: preferred_username
    - name: oidc-groups-claim
      value: groups
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
