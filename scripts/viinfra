#!/bin/bash
# viinfra — schema-validated editor for infrastructure.yaml
# Usage:
#   viinfra              # edit infrastructure.yaml with lint
#   viinfra --regen      # regenerate SCHEMA_REFERENCE.md from schema
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
SCHEMA="$PROJECT_DIR/conf/infrastructure.schema.yaml"
INFRA="$PROJECT_DIR/conf/infrastructure.yaml"
GENERATE_DOCS="$SCRIPT_DIR/generate-schema-docs.py"

# Ensure python3 + jsonschema are available
python3 -c "import jsonschema, yaml" 2>/dev/null || {
  echo "ERROR: python3 with jsonschema and pyyaml required."
  exit 1
}

validate_schema() {
  python3 -c "
import json, sys, yaml, jsonschema

with open('$SCHEMA') as f:
    schema = yaml.safe_load(f)

# Load JSON Schema metaschema
import urllib.request
url = schema.get('\$schema', 'http://json-schema.org/draft-07/schema#')
try:
    with urllib.request.urlopen(url) as resp:
        metaschema = json.loads(resp.read())
except Exception:
    # If we can't fetch, skip metaschema validation
    sys.exit(0)

try:
    jsonschema.validate(schema, metaschema)
except jsonschema.ValidationError as e:
    print(f'Schema validation error: {e.message}', file=sys.stderr)
    if e.path:
        print(f'  at: {\".\".join(str(p) for p in e.path)}', file=sys.stderr)
    sys.exit(1)
"
}

validate_infra() {
  python3 -c "
import sys, yaml, jsonschema

with open('$SCHEMA') as f:
    schema = yaml.safe_load(f)
with open('$INFRA') as f:
    infra = yaml.safe_load(f)

try:
    jsonschema.validate(infra, schema)
except jsonschema.ValidationError as e:
    print(f'Validation error: {e.message}', file=sys.stderr)
    if e.path:
        print(f'  at: {\".\".join(str(p) for p in e.path)}', file=sys.stderr)
    sys.exit(1)
"
}

validate_infra_verbose() {
  python3 -c "
import sys, yaml, jsonschema

with open('$SCHEMA') as f:
    schema = yaml.safe_load(f)
with open('$INFRA') as f:
    infra = yaml.safe_load(f)

try:
    jsonschema.validate(infra, schema)
    sys.exit(0)
except jsonschema.ValidationError as e:
    print(f'Error: {e.message}')
    path = '.'.join(str(p) for p in e.path) if e.path else '(root)'
    print(f'  at: {path}')
    sys.exit(1)
"
}

show_errors_menu() {
  echo ""
  echo "Schema validation failed."
  echo ""
  echo "  1. Show errors"
  echo "  2. Re-enter editor"
  echo "  3. Quit without saving"
  echo ""
  printf "Choice [1-3]: "
  read -r choice
  case "$choice" in
    1)
      validate_infra_verbose || true
      echo ""
      show_errors_menu
      ;;
    2)
      edit_and_validate
      ;;
    3)
      echo "Aborted."
      exit 1
      ;;
    *)
      echo "Invalid choice."
      show_errors_menu
      ;;
  esac
}

edit_and_validate() {
  local tmpfile
  tmpfile=$(mktemp /tmp/infraops-infra-XXXX.yaml)
  cp "$INFRA" "$tmpfile"

  local before
  before=$(md5sum "$tmpfile" | cut -d' ' -f1)

  "${EDITOR:-vim}" "$tmpfile"

  local after
  after=$(md5sum "$tmpfile" | cut -d' ' -f1)

  if [ "$before" = "$after" ]; then
    echo "No changes made."
    rm -f "$tmpfile"
    exit 0
  fi

  # Temporarily point INFRA to the copy for validation
  local real_infra="$INFRA"
  INFRA="$tmpfile"

  if validate_infra 2>/dev/null; then
    cp "$tmpfile" "$real_infra"
    INFRA="$real_infra"
    echo "Saved and validated."
    rm -f "$tmpfile"
    exit 0
  else
    INFRA="$real_infra"
    show_errors_menu
    rm -f "$tmpfile"
    exit 1
  fi
}

# --- Main ---

if [ "${1:-}" = "--regen" ]; then
  echo "Validating schema..."
  if ! validate_schema; then
    echo "Schema has errors. Fix the schema before regenerating docs."
    exit 1
  fi
  echo "Schema OK. Generating SCHEMA_REFERENCE.md..."
  python3 "$GENERATE_DOCS"
  exit 0
fi

edit_and_validate
