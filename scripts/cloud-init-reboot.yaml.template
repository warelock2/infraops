#cloud-config

# ===========================================================================
# cloud-init snippet injected into every new VM (vendor data).
#
# This is the SOURCE OF THE READINESS CONTRACT. When Terraform clones a VM
# it attaches this snippet (filled in by ansible/create-proxmox-snippet.sh,
# which substitutes __NATS_VM_PASSWORD__). What happens:
#
#   1. runcmd arms the reboot flag (/var/run/reboot-required), writes
#      /etc/helloworld/hostinfo.txt (hostname/ip/vm_id from the system),
#      then starts helloworld.service.
#   2. helloworld.sh waits for cloud-init; if the reboot flag is present it
#      reboots first (a clean reboot re-registers DHCP/DNS and re-runs
#      cloud-init). Otherwise it validates hostname/IP/route/sshd/NATS
#      (healing what it can), and ONLY THEN publishes
#      infraops.helloworld on NATS.
#   3. The CI orchestrator consumes that signal (wait-for-readiness.sh) and
#      replies on the ack subject. On ack, the service self-destructs —
#      the VM is now a normal machine Ansible can manage.
#
# The NIC name is never manipulated: the cloudimg + Proxmox procedure
# naturally produces "eth0", pinned by cloud-init's netplan config via MAC
# (match: macaddress + set-name: eth0 -> systemd .link Name=eth0). That pin
# is deterministic and stable across reboots, so we standardize on eth0 and
# leave netplan alone.
#
# Validation failures trigger a reboot (maybe_reboot) up to MAX_REBOOTS;
# this is the "reboot dance" the Ansible plays no longer need to poll for.
# ===========================================================================

packages:
  - qemu-guest-agent

write_files:
  - path: /etc/systemd/system/helloworld.service
    content: |
      [Unit]
      Description=VM Readiness Heartbeat
      After=cloud-init.service network-online.target sshd.service
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/helloworld.sh

      [Install]
      WantedBy=multi-user.target
    permissions: "0644"

  - path: /usr/local/bin/helloworld.sh
    content: |
      #!/bin/bash
      set -euo pipefail

      CONTEXT="vm"
      SUBJECT="infraops.helloworld"
      ACK_PREFIX="infraops.helloworld.ack"
      HOSTINFO="/etc/helloworld/hostinfo.txt"
      MAX_ATTEMPTS=3
      MAX_REBOOTS=3
      REBOOT_SIGNAL_AFTER=2
      REBOOT_FLAG="/var/run/reboot-required"
      REBOOT_COUNT_FILE="/etc/helloworld/reboot_count"
      SSH_PROBE_TIMEOUT=5
      SSH_POLL_WAIT=30
      PUBLISH_INTERVAL=300
      ACK_TIMEOUT=300

      log() {
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) helloworld: $*" >&2
      }

      read_auth_facts() {
        AUTH_HOSTNAME=$(grep '^hostname:' "$HOSTINFO" | awk '{print $2}')
        AUTH_IP=$(grep '^ip:' "$HOSTINFO" | awk '{print $2}')
        AUTH_VMID=$(grep '^vm_id:' "$HOSTINFO" | awk '{print $2}')
        log "auth facts: hostname=$AUTH_HOSTNAME ip=$AUTH_IP vmid=$AUTH_VMID"
      }

      wait_for_cloud_init() {
        log "waiting for cloud-init to finish..."
        local count=0
        # Ask cloud-init itself, not the /var/lib/cloud/.../boot-finished
        # marker. That file persists across the reboot dance (it is written at
        # the end of a cloud-init pass but never cleared at boot), so a marker
        # check can pass while cloud-init is still mid-run. `cloud-init status`
        # reflects the CURRENT pass: it prints "status: done" only once the
        # running stage has completed. "status: error" means the pass failed
        # and helloworld must not signal readiness.
        while true; do
          local ci_status
          ci_status=$(cloud-init status 2>/dev/null | grep -oP 'status: \K\w+' || true)
          case "$ci_status" in
            done)
              log "cloud-init finished"
              return 0
              ;;
            error)
              log "cloud-init reported an error"
              return 1
              ;;
          esac
          sleep 5
          count=$((count + 1))
          if [ $count -ge 120 ]; then
            log "timeout waiting for cloud-init (600s)"
            return 1
          fi
        done
      }

      configure_sysctl() {
        for mod in overlay br_netfilter; do modprobe "$mod"; done
        local k8s_conf="/etc/sysctl.d/k8s.conf"
        printf '%s\n' \
          'net.bridge.bridge-nf-call-iptables = 1' \
          'net.bridge.bridge-nf-call-ip6tables = 1' \
          'net.ipv4.ip_forward = 1' > "$k8s_conf"
        sysctl --system
      }

      ssh_banner_up() {
        timeout "$SSH_PROBE_TIMEOUT" bash -c 'echo | nc 127.0.0.1 22' 2>/dev/null | grep -q '^SSH-2.0-'
      }

      validate_and_heal() {
        local fail=0
        configure_sysctl

        local current_hostname
        current_hostname=$(hostname)
        if [ "$current_hostname" != "$AUTH_HOSTNAME" ]; then
          log "hostname mismatch: have=$current_hostname want=$AUTH_HOSTNAME — fixing"
          hostnamectl set-hostname "$AUTH_HOSTNAME"
          fail=1
        fi

        local current_ip
        current_ip=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -1)
        if [ "$current_ip" != "$AUTH_IP" ]; then
          log "IP mismatch: have=$current_ip want=$AUTH_IP — cannot fix, will reboot"
          fail=1
        fi

        if ! ip route show default > /dev/null 2>&1; then
          log "no default route — cannot fix, will reboot"
          fail=1
        fi

        if ! ssh_banner_up; then
          log "ssh banner not received — waiting ${SSH_POLL_WAIT}s"
          sleep "$SSH_POLL_WAIT"
        fi

        if ! ssh_banner_up; then
          log "ssh banner still not received — restarting sshd"
          systemctl restart sshd 2>/dev/null || true
          sleep "$SSH_POLL_WAIT"
        fi

        if ! ssh_banner_up; then
          log "ssh banner still not received after restart — rebooting"
          maybe_reboot
        fi

        local nats_ok=0
        for i in 1 2 3; do
          if nats rtt --context="$CONTEXT" > /dev/null 2>&1; then
            nats_ok=1
            break
          fi
          log "NATS not reachable, attempt $i/3"
          sleep 5
        done
        if [ $nats_ok -eq 0 ]; then
          log "NATS unreachable after 3 attempts — cannot fix, will reboot"
          fail=1
        fi

        return $fail
      }

      publish_readiness() {
        TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        PAYLOAD="{\"hostname\":\"$AUTH_HOSTNAME\",\"ip\":\"$AUTH_IP\",\"vmid\":\"$AUTH_VMID\",\"timestamp\":\"$TIMESTAMP\"}"
        log "publishing readiness: $PAYLOAD"
        nats pub "$SUBJECT" "$PAYLOAD" --context="$CONTEXT" -J
      }

      publish_failure() {
        TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        PAYLOAD="{\"hostname\":\"$AUTH_HOSTNAME\",\"ip\":\"$AUTH_IP\",\"vmid\":\"$AUTH_VMID\",\"status\":\"fail\",\"reason\":\"$1\",\"timestamp\":\"$TIMESTAMP\"}"
        log "publishing failure: $PAYLOAD"
        nats pub "infraops.helloworld.fail.$AUTH_HOSTNAME" "$PAYLOAD" --context="$CONTEXT" -J
      }

      wait_for_ack() {
        local ack_file="/tmp/helloworld_ack_$$"
        rm -f "$ack_file"

        log "subscribing to $ACK_PREFIX.$AUTH_HOSTNAME for ack"
        nats sub "$ACK_PREFIX.$AUTH_HOSTNAME" --context="$CONTEXT" --count=1 --timeout="${ACK_TIMEOUT}s" > "$ack_file" 2>/dev/null &
        local sub_pid=$!

        sleep 2

        publish_readiness

        wait "$sub_pid" 2>/dev/null || true

        if [ -s "$ack_file" ]; then
          log "ack received"
          rm -f "$ack_file"
          return 0
        fi

        rm -f "$ack_file"
        log "no ack received within ${ACK_TIMEOUT}s"
        return 1
      }

      self_destruct() {
        log "self-destructing"
        systemctl disable helloworld.service 2>/dev/null || true
        systemctl reset-failed helloworld.service 2>/dev/null || true
      }

      maybe_reboot() {
        local reboot_count=0
        if [ -f "$REBOOT_COUNT_FILE" ]; then
          reboot_count=$(cat "$REBOOT_COUNT_FILE")
        fi
        reboot_count=$((reboot_count + 1))
        echo "$reboot_count" > "$REBOOT_COUNT_FILE"

        if [ "$reboot_count" -gt "$MAX_REBOOTS" ]; then
          log "max reboots ($MAX_REBOOTS) reached — giving up, leaving VM for forensics"
          publish_failure "gave up after $MAX_REBOOTS reboots: system not ready"
          self_destruct
          exit 1
        fi

        if [ "$reboot_count" -ge "$REBOOT_SIGNAL_AFTER" ]; then
          publish_failure "reboot $reboot_count/$MAX_REBOOTS: system not ready"
        fi

        log "reboot $reboot_count/$MAX_REBOOTS"
        reboot
        # `reboot` only signals systemd and returns immediately, so without an
        # explicit exit the script falls through into validation / the
        # readiness loop while a reboot is already pending — logging
        # "validation attempt" after "rebooting before any validation" (seen
        # on test01). Never proceed once a reboot has been issued.
        exit 0
      }

      # --- main ---
      log "starting"
      wait_for_cloud_init || exit 1
      read_auth_facts

      # FIRST ACTION: honor a pending reboot before doing anything else. A
      # fresh cloud-init pass may have set /var/run/reboot-required (e.g. a
      # package/kernel upgrade needing a reboot). Reboot now — a clean reboot
      # re-registers DHCP/DNS and re-runs cloud-init, which usually makes
      # everything else just work. The flag lives in tmpfs, so it is cleared
      # by the reboot itself and cannot trigger a loop.
      if [ -f "$REBOOT_FLAG" ]; then
        log "reboot flag present ($REBOOT_FLAG) — rebooting before any validation"
        maybe_reboot
      fi

      validation_ok=0
      for attempt in $(seq 1 $MAX_ATTEMPTS); do
        log "validation attempt $attempt/$MAX_ATTEMPTS"
        if validate_and_heal; then
          log "validation passed"
          validation_ok=1
          break
        fi
        sleep 2
      done

      # Validation failures are supposed to trigger a reboot (see header
      # comment) so a fresh cloud-init pass can re-apply the network config.
      # Previously this fell through to the readiness loop regardless of the
      # validation result, publishing readiness with a wrong IP.
      if [ "$validation_ok" -ne 1 ]; then
        log "validation failed after $MAX_ATTEMPTS attempts - cannot proceed, rebooting"
        maybe_reboot
      fi

      while true; do
        if wait_for_ack; then
          self_destruct
          exit 0
        fi
        log "retrying in ${PUBLISH_INTERVAL}s"
        sleep "$PUBLISH_INTERVAL"
      done
    permissions: "0755"

  - path: /root/.config/nats/context/vm.json
    content: |
      {
        "description": "VM Bootstrap",
        "url": "tls://midas.afobl.com:4222",
        "socks_proxy": "",
        "token": "",
        "user": "vm",
        "password": "__NATS_VM_PASSWORD__",
        "creds": "",
        "nkey": "",
        "cert": "",
        "key": "",
        "nsc": "",
        "jetstream_domain": "",
        "jetstream_api_prefix": "",
        "jetstream_event_prefix": "",
        "inbox_prefix": "",
        "user_jwt": "",
        "user_seed": "",
        "color_scheme": "",
        "tls_first": false,
        "windows_cert_store": "",
        "windows_cert_match_by": "",
        "windows_cert_match": "",
        "windows_ca_certs_match": null
      }
    permissions: "0600"

  # NOTE: no per-boot netplan fix. The cloudimg + Proxmox procedure naturally
  # names the NIC "eth0" and cloud-init renders a netplan config that pins it
  # by MAC (match: macaddress + set-name: eth0 -> systemd .link Name=eth0).
  # That pin is deterministic and stable across reboots, so there is nothing
  # to reconcile on every boot. Previous versions renamed eth0->$ACTUAL_IF and
  # stripped the match:/set-name: blocks, which deleted the .link pin and let
  # udev's NamePolicy flap the NIC name (ens18 <-> eth0) after boot — never do
  # that again. Standardize on eth0.

bootcmd:
  - swapoff -a
  - sed -i '/ swap / s/^/#/' /etc/fstab

runcmd:
  - systemctl enable --now qemu-guest-agent
  - chmod +x /usr/local/bin/helloworld.sh
  - mkdir -p /etc/helloworld
  - touch /var/run/reboot-required
  - >
    AUTH_HOSTNAME=$(hostname) &&
    AUTH_IP=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -1) &&
    AUTH_VMID=$(cat /sys/class/dmi/id/product_serial) &&
    printf "hostname: %s\nip: %s\nvm_id: %s\n" "$AUTH_HOSTNAME" "$AUTH_IP" "$AUTH_VMID" > /etc/helloworld/hostinfo.txt
  - systemctl enable helloworld.service
  - systemctl start helloworld.service
